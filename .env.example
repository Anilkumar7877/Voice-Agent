# Groq — reuse the key from your RAG Document Q&A project
GROQ_API_KEY=your_groq_key_here

# Cartesia — get from https://play.cartesia.ai (free tier, no card needed)
CARTESIA_API_KEY=your_cartesia_key_here

# Model config — kept here so you can swap models without touching code
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
CARTESIA_TTS_MODEL=sonic-2
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
